# ============================================================
# .gitignore —— 保证只有"代码 + 必要小文件"进仓库
# ============================================================

# ----- MATLAB 自动生成 / 备份(绝不进仓) -----
*.asv
*.fig
*.slxc
*.autosave
slprj/
codegen/
matlab3/

# ----- 数据文件:大体积中间产物一律排除,只保留必要的小文件 -----
*.mat
!foF2_12years_data.mat
!My_Trained_LSTM.mat
!norm_params.mat

# ----- 原始数据目录(公开可下载,体积 >1GB,不进仓) -----
2014/
2015/
2016/
2017/
2018/
2019/
2020/
2021/
2022/
2023/
2024/
2025/
foF2_Unzipped/

# ----- 手动备份文件 -----
*- 副本.m
*- 副本.mat
*_backup.m
*.bak
*.tmp

# ----- 操作系统垃圾 -----
.DS_Store
Thumbs.db
desktop.ini

# ----- 编辑器 / IDE 配置 -----
.vscode/
.idea/
*~
*.swp

# ----- Python(预留,后续做复现脚本时用) -----
__pycache__/
*.pyc
.ipynb_checkpoints/
